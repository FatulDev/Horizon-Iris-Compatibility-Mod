+/// A constant's constructor arguments in `code`: `const ivec3 name = ivec3(1, 2, 3);`.
+fn constant_arguments(code: &str, name: &str) -> Option<Vec<f64>> {
+    let tokens: Vec<&str> = crate::macros::lex(code)
+        .into_iter()
+        .filter(|t| !t.trim().is_empty())
+        .collect();
+    let at = tokens.iter().position(|t| *t == name)?;
+    let open = tokens[at..].iter().position(|t| *t == "(")? + at;
+    let close = tokens[open..].iter().position(|t| *t == ")")? + open;
+    let numbers: Vec<f64> = tokens[open + 1..close]
+        .split(|t| *t == ",")
+        .map(|arg| arg.concat().trim_end_matches(['f', 'F', 'u', 'U']).parse::<f64>())
+        .collect::<Result<_, _>>()
+        .ok()?;
+    Some(numbers)
+}
