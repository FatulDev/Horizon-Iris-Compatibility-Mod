+        match layout_at {
+            Some(at) => _ = self.replaced.insert(at, decl),
+            None => {
+                let first = words[0];
+                let t = text(first).to_owned();
+                self.replaced.insert(first, format!("{decl} {t}"));
+            }
+        }
