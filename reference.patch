+        let next = |i: usize| (i + 1..self.tokens.len()).find(|&j| significant(self.tokens[j]));
+        let prev = |i: usize| (0..i).rev().find(|&j| significant(self.tokens[j]));
+        let mut edits: Vec<(usize, String)> = Vec::new();
+        for i in 0..self.tokens.len() {
