+const fn make_coords_arg(number_of_components: usize, kind: Sk) -> TypeInner {
+    let scalar = Scalar { kind, width: 4 };
+
+    match number_of_components {
+        1 => TypeInner::Scalar(scalar),
+        _ => TypeInner::Vector {
+            size: match number_of_components {
+                2 => VectorSize::Bi,
+                3 => VectorSize::Tri,
+                _ => VectorSize::Quad,
+            },
+            scalar,
+        },
+    }
+}
